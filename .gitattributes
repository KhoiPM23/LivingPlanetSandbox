# Normalize EOL for text files
* text=auto eol=lf

# Godot specific
*.godot text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
*.webp binary
*.glb binary
*.gltf text
*.blend binary
*.wav binary
*.ogg binary
*.dll binary
*.so binary
*.dylib binary
